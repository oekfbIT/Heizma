# ---------------------------------------------------------------
# Heizma Case Study – Konfiguration
# Kopieren nach .env und Token eintragen:  cp .env.example .env
# ---------------------------------------------------------------

# Datenquelle: live = Heizma Case-Study-API, mock = lokale Beispieldaten (offline)
DATA_SOURCE=live

# Read-only Case-Study-API (Token kommt mit der Einladung per Mail)
HEIZMA_API_BASE_URL=https://app.heizma.at/api/casestudy
HEIZMA_API_TOKEN=

# Planungszeitraum (max. 31 Tage)
PLAN_FROM=2026-11-23
PLAN_TO=2026-11-27

# Ports
API_PORT=4000
WEB_PORT=8080

# Cache für API-Antworten in Sekunden (Datenstand ist eingefroren)
CACHE_TTL_SECONDS=600

# Heizma Firmensitz (nur Referenzpunkt auf der Karte)
OFFICE_LAT=48.2165
OFFICE_LNG=16.3786

# Kartenkacheln (optional). Leer = Esri World Street Map, kein Key nötig.
# Noch reduzierter (grau): https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}
# Beispiel MapTiler (Google-ähnlicher Stil, Key gratis auf maptiler.com):
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=DEIN_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Google Maps (optional). Gesetzt = Google Maps, leer = freie Kacheln (Leaflet).
# Key: https://console.cloud.google.com/google/maps-apis/credentials (Maps JavaScript API aktivieren)
VITE_GOOGLE_MAPS_API_KEY=
# Map-ID für eigenen Kartenstil (optional, Standard: DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=
