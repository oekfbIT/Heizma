{
  "name": "@heizma/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json && cp -r src/fixtures dist/fixtures",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "travel:prewarm": "tsx --env-file-if-exists=../.env src/prewarmTravel.ts",
    "test": "tsc -p tsconfig.test.json && node --test '.test-dist/__tests__/*.test.js'",
    "test:coverage": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-coverage-exclude='.test-dist/__tests__/**' '.test-dist/__tests__/*.test.js'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
